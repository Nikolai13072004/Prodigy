# Copy this file to .env and replace every placeholder locally.
# Never commit the resulting .env file.
DATABASE_URL=file:./dev.db
AUTH_SECRET=replace-with-a-long-random-value
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
EMAIL_PROVIDER=stub

# Production SMTP values belong only in the deployment environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_SERVERNAME=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
